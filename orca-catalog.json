{
  "catalogVersion": 2,
  "name": "gino8080 Orca plugins",
  "owner": "gino8080",
  "plugins": [
    {
      "id": "gino8080.git-overview",
      "source": {
        "kind": "git",
        "url": "https://github.com/gino8080/orca-git-overview.git",
        "ref": "main"
      },
      "description": "Folder with several git repos and no shared .git? See which have pending changes, are behind their remote or sit on a different branch, and fetch them all in one click.",
      "categories": [
        "git"
      ],
      "releases": [
        {
          "version": "0.1.7",
          "commit": "49c77d30459cbff105d02a18d702815ee5f16c96",
          "contentHash": "158171aaa2484830d6a90e949dfec7764e4a53b6f21e8d14e473d4c82c84671c",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "Multi-Repo Git Overview",
          "contributes": [
            {
              "kind": "panels",
              "name": "Git Overview"
            },
            {
              "kind": "customEditors",
              "name": "Git Diff",
              "detail": ".gitdiff"
            },
            {
              "kind": "statusBarItems",
              "name": "Git Overview"
            }
          ],
          "capabilities": [
            "storage:own",
            "workspace:read",
            "workspace:write",
            "settings:own"
          ],
          "fileTypes": [
            "gitdiff"
          ],
          "editorFileTypes": [
            "gitdiff"
          ],
          "images": {
            "icon": {
              "path": "assets/icon.png",
              "alt": "Multi-Repo Git Overview",
              "sha256": "5d3725cbb02cacde4468d7e2a3711861b2b1fd24740743d7ab6eda5c250b4c44",
              "width": 512,
              "height": 512
            },
            "cover": {
              "path": "assets/cover.png",
              "alt": "Multi-Repo Git Overview: every repository of a folder in one panel, with pending changes, ahead/behind and branch mismatches",
              "sha256": "87a9b6a09719fe696971915c870126499d227f95a784bd06eba132fcc88f9a9e",
              "width": 1600,
              "height": 1000
            },
            "screenshots": [
              {
                "path": "assets/screenshot-overview.png",
                "alt": "Summary bar (5 repos, 3 with changes, 1 behind, 1 ahead, on 2 branches) above the list of five repositories and one repo's staged file",
                "sha256": "57521e2cbb8bfeb4bac49e5bae66773e3f34375db42ae271ff0b49f1ba7a4eff",
                "width": 1402,
                "height": 876
              },
              {
                "path": "assets/screenshot-graph.png",
                "alt": "The same panel with the commit graph of one repository and the files changed by the selected commit",
                "sha256": "3b50247c329489f1e6cb8a09f68b0dd0a8af7579e03422f93d0c228daad62956",
                "width": 1402,
                "height": 1050
              }
            ]
          }
        }
      ]
    }
  ]
}