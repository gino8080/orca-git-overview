{
  "catalogVersion": 2,
  "name": "gino8080 Orca plugins",
  "owner": "gino8080",
  "plugins": [
    {
      "id": "gino8080.git-overview",
      "source": {
        "kind": "git",
        "url": "https://github.com/gino8080/orca-git-overview.git",
        "ref": "main"
      },
      "description": "Git status, branches, commit graph and file history for every repository in the active workspace folder, in one panel.",
      "categories": ["git"],
      "releases": [
        {
          "version": "0.1.1",
          "commit": "952fac90ea93e5056708ea13e8ca81a095d2a455",
          "contentHash": "17f74de1034403b5db44b3f584a525d75cd91127f01dffc9de75c9bedaf647f9",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "Multi-Repo Git Overview",
          "contributes": [
            {
              "kind": "panels",
              "name": "Git Overview"
            },
            {
              "kind": "customEditors",
              "name": "Git Diff",
              "detail": ".gitdiff"
            },
            {
              "kind": "statusBarItems",
              "name": "Git Overview"
            }
          ],
          "capabilities": [
            "storage:own",
            "workspace:read",
            "workspace:write",
            "settings:own"
          ],
          "fileTypes": ["gitdiff"],
          "editorFileTypes": ["gitdiff"],
          "images": {
            "icon": {
              "path": "assets/icon.png",
              "alt": "Multi-Repo Git Overview",
              "sha256": "5d3725cbb02cacde4468d7e2a3711861b2b1fd24740743d7ab6eda5c250b4c44",
              "width": 512,
              "height": 512
            },
            "cover": {
              "path": "assets/cover.png",
              "alt": "Multi-Repo Git Overview: status, branches and commit graph of every repository, in dark and light theme",
              "sha256": "c7d403e55d49347509280d5447b09f242ab08a71c845b094281b6b7f0bd219ef",
              "width": 1600,
              "height": 1000
            },
            "screenshots": [
              {
                "path": "assets/screenshot-graph.png",
                "alt": "Panel listing five repositories with their status, and the commit graph of one repository with a commit's changed files",
                "sha256": "51f3519b17bdf2a0fb33172191a5371c0eb0792f21451e126f7a4da3792953bf",
                "width": 1616,
                "height": 1010
              }
            ]
          }
        },
