{
  "catalogVersion": 2,
  "name": "gino8080 Orca plugins",
  "owner": "gino8080",
  "plugins": [
    {
      "id": "gino8080.git-overview",
      "source": {
        "kind": "git",
        "url": "https://github.com/gino8080/orca-git-overview.git",
        "ref": "main"
      },
      "description": "For a folder of independent git repos, each with its own .git and no shared parent. See which have pending changes, are behind their remote or sit on a different branch, and fetch them all in one click. Orca's native Source Control covers attached worktrees; this covers plain sub-repos.",
      "categories": [
        "git"
      ],
      "releases": [
        {
          "version": "0.1.9",
          "commit": "a36f0e2ae4ba551a98d1472eb67f576b28d8f153",
          "contentHash": "36a9f3870b1041f052da0aaa5f37052e147ae398a7c9226a895f9c7de192b816",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "Multi-Repo Git Overview",
          "contributes": [
            {
              "kind": "panels",
              "name": "Git Overview"
            },
            {
              "kind": "customEditors",
              "name": "Git Diff",
              "detail": ".gitdiff"
            },
            {
              "kind": "statusBarItems",
              "name": "Git Overview"
            }
          ],
          "capabilities": [
            "storage:own",
            "workspace:read",
            "workspace:write",
            "settings:own"
          ],
          "fileTypes": [
            "gitdiff"
          ],
          "editorFileTypes": [
            "gitdiff"
          ],
          "images": {
            "icon": {
              "path": "assets/icon.png",
              "alt": "Multi-Repo Git Overview",
              "sha256": "5d3725cbb02cacde4468d7e2a3711861b2b1fd24740743d7ab6eda5c250b4c44",
              "width": 512,
              "height": 512
            },
            "cover": {
              "path": "assets/cover.png",
              "alt": "Multi-Repo Git Overview: every repository of a folder in one panel, with pending changes, ahead/behind and branch mismatches",
              "sha256": "87a9b6a09719fe696971915c870126499d227f95a784bd06eba132fcc88f9a9e",
              "width": 1600,
              "height": 1000
            },
            "screenshots": [
              {
                "path": "assets/screenshot-overview.png",
                "alt": "Summary bar (5 repos, 3 with changes, 1 behind, 1 ahead) over the five repos, with the commit graph and a commit's files of the selected repo",
                "sha256": "24211ae05149aada70060e9568c4e583c21762c7751e935f3b0d869cdc53799f",
                "width": 1402,
                "height": 1260
              }
            ]
          }
        }
      ]
    }
  ]
}